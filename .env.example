## Published web port on this Linux host (container always listens on 8080)
PKAPPA2_HTTP_PORT=8080
PKAPPA2_BIND_ADDRESS=0.0.0.0

## Generated exploits are saved here by the "В DestructiveFarm" button.
## scripts/setup.sh automatically selects ../DestructiveFarm/client when it exists.
DESTRUCTIVE_FARM_CLIENT_DIR=./farm_exports
## scripts/setup.sh replaces this with the export directory's host group id.
PKAPPA2_FARM_EXPORT_GID=1000

## HTTP auth passwords. scripts/setup.sh generates random values on first run.
## For manual setup, set both passwords before starting the containers.
PKAPPA2_USER_PASSWORD=

## HTTP auth password for pcaps (/upload endpoint)
PKAPPA2_PCAP_PASSWORD=

## All paths are relative to this path (default "/tmp")
PKAPPA2_BASE_DIR=/data

## Path where indexes will be stored
# PKAPPA2_INDEX_DIR=

## Path where pcaps will be stored
# PKAPPA2_PCAP_DIR=

## Path where snapshots will be stored
# PKAPPA2_SNAPSHOT_DIR=

## Path where state files will be stored
# PKAPPA2_STATE_DIR=

## Path where converter executables are searched (default "./converters")
# PKAPPA2_CONVERTER_DIR=

## Path where new pcap files are searched and imported (default "")
PKAPPA2_WATCH_DIR=/pcaps_in

## enable checking of tcp options
# PKAPPA2_TCP_CHECK_OPTIONS=1

## enable checking of tcp state (default true)
# PKAPPA2_TCP_CHECK_STATE=1
